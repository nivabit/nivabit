# Application Port on Host
APP_PORT=3001

# PostgreSQL Configuration
DB_PORT=5434
POSTGRES_USER=nivabit
POSTGRES_PASSWORD=nivabit_secret
POSTGRES_DB=nivabit

# Database Connection URL (app inside Docker network)
DATABASE_URL=postgresql://nivabit:nivabit_secret@db:5432/nivabit?schema=public

# Database Connection URL (if connecting from host machine directly e.g. DBeaver / Prisma Studio)
# DATABASE_URL=postgresql://nivabit:nivabit_secret@localhost:5434/nivabit?schema=public

# Auth Secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
JWT_SECRET=your_jwt_secret_here

# SMTP Configuration (Optional for local development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_EMAIL=contact@nivabit.com
