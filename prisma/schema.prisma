// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String      @id @default(uuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           String
  phone          String   @unique
  resetToken     String?  
  resetTokenExp  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 🔗 opposite side of the relation
  articles       Article[]   @relation("AdminArticles")
}

model Article {
  id             String   @id @default(uuid())
  title          String
  excerpt        String
  content        String
  categories     String[] // Postgres supports arrays
  status         ArticleStatus @default(DRAFT)   // "Draft" | "Published" | "Scheduled"
  publishDate    DateTime
  tags           String[]
  featuredImage  String?
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  views          Int      @default(0)

  // 🔗 relation: article belongs to an admin
  authorId       String
  author         Admin    @relation("AdminArticles", fields: [authorId], references: [id])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Contact {
  id        String      @id @default(uuid())
  name      String
  services  String?
  email     String
  subject   String
  message   String?
  isread    Boolean  @default(false)
  isreadAt  DateTime?
  createdAt DateTime @default(now())
}